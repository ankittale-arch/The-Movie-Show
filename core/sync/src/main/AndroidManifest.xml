<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
    Registers SyncInitializer with androidx.startup so the periodic outbox sync is scheduled at
    process start without adding scheduling logic to TheMovieShowApplication.onCreate (see its
    doc comment). tools:node="merge" combines this <provider> with the app module's own
    androidx-startup provider entry (which removes WorkManager's default eager initializer,
    since Configuration.Provider requires on-demand initialization instead) rather than one
    replacing the other.
    -->
    <application>
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="com.ankitt.themovieshow.core.sync.SyncInitializer"
                android:value="androidx.startup" />
        </provider>
    </application>
</manifest>
